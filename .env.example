# Backend
DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_HOST=db
POSTGRES_PORT=5432
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
