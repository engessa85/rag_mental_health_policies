# Backend
# Production (psychnurse.site on Contabo): set a real random secret, DEBUG=0,
# and restrict ALLOWED_HOSTS to your domain.
DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
# ALLOWED_HOSTS=psychnurse.site,www.psychnurse.site
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_HOST=db
POSTGRES_PORT=5432
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=768
USE_GENERATIVE_ANSWER=1
PRELOAD_PDF_PATH=/app/data/book.pdf
PRELOAD_PDF_NAME=Book and policies.pdf
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
MAX_CONTEXT_CHARS=12000
MAX_ANSWER_TOKENS=1024
CORS_ALLOW_ALL_ORIGINS=1

# Frontend
# This is baked into the JS bundle at build time (docker compose build arg),
# so changing it requires: docker compose up --build frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
# NEXT_PUBLIC_API_BASE=https://psychnurse.site/api
